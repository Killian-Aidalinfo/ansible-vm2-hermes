# Géré par Ansible
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight:{{ hindsight_db_password }}@hindsight-db:5432/hindsight
{% if llm_api_key %}
HINDSIGHT_API_LLM_PROVIDER={{ llm_provider }}
HINDSIGHT_API_LLM_API_KEY={{ llm_api_key }}
HINDSIGHT_API_LLM_MODEL={{ hindsight_llm_model }}
{% else %}
HINDSIGHT_API_LLM_PROVIDER=none
{% endif %}
# Toute requête à l'API (REST et MCP) exige « Authorization: Bearer <clé> ».
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
HINDSIGHT_API_TENANT_API_KEY={{ hindsight_api_key }}
HINDSIGHT_CP_ACCESS_KEY={{ hindsight_cp_key }}
